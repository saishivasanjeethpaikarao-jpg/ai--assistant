# AIRIS Mobile App — Environment Variables
# Copy this file to `.env` and fill in your values.
# Never commit `.env` to version control.
#
# All vars MUST be prefixed with EXPO_PUBLIC_ to be exposed to the client.

# ── Backend URL ────────────────────────────────────────────────────────────
# Local development: http://127.0.0.1:8000
# Deployed: https://airis-backend.onrender.com
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# ── Feature flags (optional) ───────────────────────────────────────────────
# Disable voice input/output if backend doesn't support it
EXPO_PUBLIC_ENABLE_VOICE=true
