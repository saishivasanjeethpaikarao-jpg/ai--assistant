{
  "build": {
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist",
    "features": []
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "AIRIS - AI Assistant",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "package": {
    "productName": "AIRIS",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": true,
        "open": true,
        "sidecar": true
      },
      "fs": {
        "all": true,
        "readTextFile": true,
        "writeTextFile": true,
        "readDir": true,
        "createDir": true,
        "removeDir": true,
        "copyFile": true,
        "removeFile": true,
        "renameFile": true,
        "exists": true,
        "scope": ["$APPDATA", "$APPDATA/*", "$HOME", "$HOME/*", "$TEMP/*"]
      },
      "path": {
        "all": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://*", "https://*"]
      },
      "window": {
        "all": true,
        "create": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "show": true,
        "hide": true,
        "close": true,
        "setResizable": true,
        "setTitle": true,
        "setFullscreen": true,
        "startDragging": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "notification": {
        "all": true
      },
      "process": {
        "all": true,
        "exit": true
      },
      "clipboard": {
        "all": true,
        "writeText": true,
        "readText": true
      }
    },
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis", "dmg", "deb", "AppImage"],
      "identifier": "com.airis.app",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
      "resources": [],
      "externalBin": [],
      "copyright": "AIRIS © 2024",
      "category": "Utility",
      "shortDescription": "Advanced AI Assistant",
      "longDescription": "AIRIS - Your intelligent AI personal assistant with voice, trading, and autonomous capabilities",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "",
        "useBootstrapper": true,
        "exceptionDomain": "",
        "signingIdentity": null,
        "notarize": null,
        "hardendedRuntime": true
      },
      "linux": {
        "deb": {
          "depends": []
        },
        "appimage": {
          "bundleMediaToken": false
        },
        "snap": null
      }
    },
    "updater": {
      "active": true,
      "endpoints": ["https://releases.example.com/{{target}}/{{arch}}/update.json"],
      "dialog": true,
      "pubkey": "pub_key_here"
    }
  }
}
