# AIRIS AI Assistant — Environment Variables
# Copy this file to `.env` and fill in your values.
# Never commit `.env` to version control.

# ── LLM Providers (at least one required) ──────────────────────────────────

# Groq — recommended (free tier, very fast)
# Get a key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20240620

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# NVIDIA NIM
NVIDIA_NIM_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Together AI
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3-70b

# Ollama (local — no key needed, just a running instance)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Voice Services ─────────────────────────────────────────────────────────

# Fish Audio — premium TTS and voice cloning
# Get a key at: https://fish.audio
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2-pro
FISH_AUDIO_REFERENCE_ID=

# ElevenLabs — alternative premium TTS
ELEVENLABS_API_KEY=

# ── Firebase (optional — for cloud sync and auth) ──────────────────────────

FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Safety / Behaviour ─────────────────────────────────────────────────────

# Set to "1" to enable self-improvement (DANGEROUS — requires AIRIS_SAFE_MODE=0)
AIRIS_SELF_IMPROVE_ALLOW=0

# Set to "1" to disable safe mode (skips confirmations for run/shutdown/restart)
AIRIS_SAFE_MODE=1

# Comma-separated list of CORS-allowed origins
# Leave empty to use the default list in backend/cors_allowlist.py
AIRIS_ALLOWED_ORIGINS=

# Render data directory (for hosted deployments)
# RENDER_DATA_DIR=/var/data

# SQLite database path (optional — defaults to user data dir)
# AIRIS_DB_PATH=/var/data/settings.db

# ── Server ─────────────────────────────────────────────────────────────────

# Backend port (default 8000)
AIRIS_PORT=8000

# Debug mode (verbose logging)
DEBUG=false
LOG_LEVEL=info
